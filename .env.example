# Copia questo file in ".env" (stesso nome, senza ".example") e incolla i valori
# che trovi nella console Firebase, in: Impostazioni progetto > Le tue app > App web.
# Vedi il README per i passaggi dettagliati.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Consigliere d'asta (facoltativo): indirizzo del Worker Cloudflare che tiene
# la chiave OpenAI. Vedi worker/LEGGIMI.md. Qui va SOLO l'indirizzo, mai la
# chiave: questo valore finisce dentro il JavaScript pubblico del sito.
# Se la riga manca, il consigliere non compare e il resto funziona uguale.
VITE_CONSIGLIERE_URL=
