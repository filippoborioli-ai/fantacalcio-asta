rules_version = '2';

// Regole volutamente semplici: chiunque conosca il codice di un'asta
// (6 caratteri, ~1 miliardo di combinazioni) può leggerla e modificarla.
// Non c'è login: è lo stesso modello "di fiducia tra amici" già usato
// prima. Se in futuro vuoi account e permessi veri, qui è il punto
// da cui partire per aggiungere l'autenticazione Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    match /aste/{codice} {
      allow read, write: if true;
    }
    // Listone giocatori Serie A: condiviso tra tutte le aste, non legato a
    // un codice. Stesso modello di fiducia: chi ha accesso all'app lo può
    // aggiornare (es. a inizio stagione con le nuove quotazioni).
    match /listoni/{listino} {
      allow read, write: if true;
    }
  }
}
